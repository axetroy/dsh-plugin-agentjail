# Generated by dsh-plugin-agentjail from template "no-credential-access".
# Edit the template in the plugin source, or replace this file with your own rules.
package agentjail.dsh.templates.no_credential_access

# Deny reads and writes of credential-bearing paths.

deny_rules contains {"rule_id": "no-credential-access/credential-access", "reason": "access to a credential-bearing path"} if {
  path := input.tool_input.file_path
  is_credential_path(path)
}

# Helpers referenced by the rules above.

is_credential_path(path) if {
  some pattern in credential_path_patterns
  regex.match(pattern, path)
}

credential_path_patterns := [
  "(^|/)\\.ssh(/|$)",
  "(^|/)\\.aws(/|$)",
  "(^|/)\\.gnupg(/|$)",
  "(^|/)\\.kube(/|$)",
  "(^|/)\\.docker(/|$)",
  "(^|/)\\.netrc$",
  "(^|/)\\.npmrc$",
  "(^|/)\\.pypirc$",
  "(^|/)\\.env(\\.|$)",
  "\\.(pem|key|p12|pfx|jks|keystore)$",
  "(^|/)id_(rsa|dsa|ecdsa|ed25519)$",
  "(^|/)credentials(\\.|$)",
]
