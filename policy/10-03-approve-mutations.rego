# Generated by dsh-plugin-agentjail from template "approve-mutations".
# Edit the template in the plugin source, or replace this file with your own rules.
package agentjail.dsh.templates.approve_mutations

# Ask a human before every file write or edit.

ask_rules contains {"rule_id": "approve-mutations/mutation", "reason": "writing or editing a file requires approval"} if {
  input.tool_name == "Write"
}
ask_rules contains {"rule_id": "approve-mutations/mutation-edit", "reason": "writing or editing a file requires approval"} if {
  input.tool_name == "Edit"
}
