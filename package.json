{
  "name": "dsh-plugin-agentjail",
  "version": "0.1.0",
  "description": "DeepSeek Harness security plugin that routes every agent tool call through AgentJail policy checks before execution.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "agentjail",
    "security",
    "opa",
    "rego",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axetroy/dsh-plugin-agentjail.git"
  },
  "homepage": "https://github.com/axetroy/dsh-plugin-agentjail#readme",
  "bugs": {
    "url": "https://github.com/axetroy/dsh-plugin-agentjail/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/adapter/agentjail-client.d.ts",
      "default": "./lib/adapter/agentjail-client.js"
    },
    "./policy": {
      "types": "./lib/security/policy.d.ts",
      "default": "./lib/security/policy.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "policy",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "docs",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "DESIGN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "vendor": "node scripts/vendor-agentjail.mjs",
    "vendor:all": "node scripts/vendor-agentjail.mjs --all",
    "vendor:check": "node scripts/vendor-agentjail.mjs --check",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run build",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1",
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.0"
  }
}
