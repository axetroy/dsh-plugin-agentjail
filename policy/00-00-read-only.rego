# Generated by dsh-plugin-agentjail from template "read-only".
# Edit the template in the plugin source, or replace this file with your own rules.
package agentjail.dsh.templates.read_only

# Read-only posture: allow reads, deny every mutation and shell command.

deny_rules contains {"rule_id": "read-only/write", "reason": "read-only posture denies writes"} if {
  input.tool_name == "Write"
}
deny_rules contains {"rule_id": "read-only/edit", "reason": "read-only posture denies edits"} if {
  input.tool_name == "Edit"
}
deny_rules contains {"rule_id": "read-only/bash", "reason": "read-only posture denies shell commands"} if {
  input.tool_name == "Bash"
}
