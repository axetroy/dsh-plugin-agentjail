# Generated by dsh-plugin-agentjail from template "mcp-allowlist".
# Edit the template in the plugin source, or replace this file with your own rules.
package agentjail.dsh.templates.mcp_allowlist

# Deny MCP servers that are not explicitly approved.

deny_rules contains {"rule_id": "mcp-allowlist/unapproved-mcp-server", "reason": "MCP server is not on the approved list"} if {
  startswith(input.tool_name, "mcp__")
  server := mcp_server(input.tool_name)
  not approved_mcp_server(server)
}

# Helpers referenced by the rules above.

mcp_server(tool_name) := server if {
  parts := split(tool_name, "__")
  count(parts) >= 3
  server := parts[1]
}

approved_mcp_server(server) if {
  some approved in approved_mcp_servers
  approved == server
}

# Edit this list to approve a server. An unlisted server is denied.
approved_mcp_servers := ["filesystem", "git"]
