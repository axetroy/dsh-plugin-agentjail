# Generated by dsh-plugin-agentjail from template "no-remote-execution".
# Edit the template in the plugin source, or replace this file with your own rules.
package agentjail.dsh.templates.no_remote_execution

# Deny destructive deletes, pipe-to-shell, and privilege escalation.

deny_rules contains {"rule_id": "no-remote-execution/destructive-delete", "reason": "recursive force delete outside the session working directory"} if {
  input.tool_name == "Bash"
  command := input.tool_input.command
  regex.match(`\brm\s+(-[a-zA-Z]*[rR][a-zA-Z]*f|-[a-zA-Z]*f[a-zA-Z]*[rR])`, command)
  not within_cwd(command)
}
deny_rules contains {"rule_id": "no-remote-execution/remote-execution", "reason": "piping fetched content directly into a shell"} if {
  input.tool_name == "Bash"
  command := input.tool_input.command
  regex.match(`(curl|wget)[^|]*\|\s*(ba)?sh`, command)
}
deny_rules contains {"rule_id": "no-remote-execution/privilege-escalation", "reason": "privilege escalation through sudo"} if {
  input.tool_name == "Bash"
  command := input.tool_input.command
  regex.match(`(^|[;&|]\s*)sudo\s`, command)
}

# Helpers referenced by the rules above.

# A command is "within cwd" when every absolute path it names is under the
# session working directory. Without a cwd the rule cannot prove safety, so the
# deny applies.
within_cwd(command) if {
  paths := [path | some token in split(command, " "); startswith(token, "/"); path := token]
  count(paths) > 0
  every path in paths {
    startswith(path, input.cwd)
  }
}
