# Generated by dsh-plugin-agentjail from template "restricted-egress".
# Edit the template in the plugin source, or replace this file with your own rules.
package agentjail.dsh.templates.restricted_egress

# Deny outbound requests to hosts outside a small allowlist.

deny_rules contains {"rule_id": "restricted-egress/network-egress", "reason": "outbound request to a host outside the egress allowlist"} if {
  input.tool_name == "WebFetch"
  url := input.tool_input.url
  host := host_of(url)
  not allowed_host(host)
}

# Helpers referenced by the rules above.

host_of(url) := host if {
  parts := split(url, "/")
  count(parts) >= 3
  host := split(parts[2], ":")[0]
}

allowed_host(host) if {
  some pattern in allowed_host_patterns
  glob.match(pattern, ["."], host)
}

allowed_host_patterns := [
  "api.deepseek.com",
  "registry.npmjs.org",
  "pypi.org",
  "files.pythonhosted.org",
  "github.com",
  "raw.githubusercontent.com",
]
