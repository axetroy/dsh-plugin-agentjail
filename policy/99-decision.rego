# This module is the daemon-facing entrypoint. It merges the rule sets of every
# installed template and resolves them into one verdict, in a fixed order:
# a matching deny wins over a matching ask, and both win over the default allow.
#
# A bare "allow" with no rule_id is the engine reporting "no rule matched". The
# plugin reads that as a distinct outcome and applies its own configured
# defaultAction, so this module must not encode a deployment's default posture:
# a rule author cannot see the plugin's configuration.

package agentjail.dsh

import data.agentjail.dsh.templates.read_only
import data.agentjail.dsh.templates.no_credential_access
import data.agentjail.dsh.templates.no_remote_execution
import data.agentjail.dsh.templates.restricted_egress
import data.agentjail.dsh.templates.approve_mutations
import data.agentjail.dsh.templates.mcp_allowlist

# Every rule contributed by every template, flattened into two sets.
deny_rules contains rule if {
  rule := read_only.deny_rules[_]
}

deny_rules contains rule if {
  rule := no_credential_access.deny_rules[_]
}

deny_rules contains rule if {
  rule := no_remote_execution.deny_rules[_]
}

deny_rules contains rule if {
  rule := restricted_egress.deny_rules[_]
}

deny_rules contains rule if {
  rule := approve_mutations.deny_rules[_]
}

deny_rules contains rule if {
  rule := mcp_allowlist.deny_rules[_]
}

ask_rules contains rule if {
  rule := read_only.ask_rules[_]
}

ask_rules contains rule if {
  rule := no_credential_access.ask_rules[_]
}

ask_rules contains rule if {
  rule := no_remote_execution.ask_rules[_]
}

ask_rules contains rule if {
  rule := restricted_egress.ask_rules[_]
}

ask_rules contains rule if {
  rule := approve_mutations.ask_rules[_]
}

ask_rules contains rule if {
  rule := mcp_allowlist.ask_rules[_]
}

deny_ids contains rule_id if {
  some rule in deny_rules
  rule_id := rule.rule_id
}

ask_ids contains rule_id if {
  some rule in ask_rules
  rule_id := rule.rule_id
}

# The reported rule is the smallest matching id, so the outcome does not depend
# on set iteration order.
first_deny_id := id if {
  ids := sort([rule_id | rule_id := deny_ids[_]])
  count(ids) > 0
  id := ids[0]
}

first_ask_id := id if {
  not first_deny_id
  ids := sort([rule_id | rule_id := ask_ids[_]])
  count(ids) > 0
  id := ids[0]
}

decision := {"action": "deny", "rule_id": id, "reason": reason} if {
  id := first_deny_id
  some rule in deny_rules
  rule.rule_id == id
  reason := rule.reason
}

decision := {"action": "ask", "rule_id": id, "reason": reason} if {
  id := first_ask_id
  some rule in ask_rules
  rule.rule_id == id
  reason := rule.reason
}

# A call no rule matched is allowed explicitly, naming the rule that says so.
# The explicit id matters: the plugin treats a bare allow with no rule behind it
# as "no policy answered" and applies its own defaultAction, so without this the
# denylist templates below would be read as a deny-everything policy.
decision := {"action": "allow", "rule_id": "default/allow", "reason": "no deny or ask rule matched"} if {
  not first_deny_id
  not first_ask_id
}

# The flat action field is what the daemon reports when it only needs the verb.
default action := "allow"

action := "deny" if {
  first_deny_id
}

action := "ask" if {
  first_ask_id
}
